# Copy this file to `.env` for local development, and set the same variables in
# the Cloudflare Pages dashboard (Settings → Environment variables) for production.
#
# Until VITE_SANITY_PROJECT_ID is set, the site uses the built-in fallback
# content in src/data and never calls Sanity. See SANITY_SETUP.md.

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_FORMSPREE_ENDPOINT=
VITE_CALENDLY_URL=
